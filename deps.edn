{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM). It lives
 ;; in the kotoba-lang org of this workspace (transferred + renamed from
 ;; com-junkawasaki/langgraph-clj / com-junkawasaki/langchain-clj).
 ;;
 ;; This tobacco-manufacturing vertical is SELF-CONTAINED: there is no
 ;; `kotoba-lang/tobacco-manufacturing` to delegate regulatory validation to,
 ;; so the excise-tax tracking, health-warning compliance, labeling verification,
 ;; and controlled-substance auditing live as pure functions in
 ;; `tobaccomfg.registry` rather than wrapping an external lib. This repo is
 ;; standalone (forkable outside the workspace); the :local/root paths only
 ;; resolve inside the monorepo checkout -- a standalone fork should override
 ;; them with git coordinates.
 ;; For testing/CI without langgraph, use the core logic in run-operation;
 ;; production deployment requires the langgraph StateGraph integration.
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       ;; Digital Agency design system skin for build-time operator-console
        ;; (flagship checklist item 2). html/css pinned at top-level so
        ;; tools.deps can resolve against jp-go-dds's git-coordinate
        ;; transitive deps (same shape as isic-2211/tyremfg).
        io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system"
         :git/sha "f9ef46980869cc0bedddc3c552ccfd7add7cffe0"}
        io.github.kotoba-lang/html
        {:git/url "https://github.com/kotoba-lang/html"
         :git/sha "00a4c2ad43dde3df9d54b658961143c53945a379"}
        io.github.kotoba-lang/css
        {:git/url "https://github.com/kotoba-lang/css"
         :git/sha "6eda5ee28ec177b9e09fdbee92c55a050b18cf7d"}}
 :aliases
 {;; offline workspace dev -- pin transitive langchain to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}
         io.github.kotoba-lang/langgraph
         {:local/root "../../kotoba-lang/langgraph"}}}
  ;; clojure -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "tobaccomfg.sim"]}
  ;; clojure -M:dev:render-html -> build docs/samples/operator-console.html
  ;; through the real governor/store (flagship checklist item 2).
  :render-html {:main-opts ["-m" "tobaccomfg.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
